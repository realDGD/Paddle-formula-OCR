# ==========================================
# 操作系统临时文件 (OS generated)
# ==========================================
.DS_Store
.DS_Store?
.Trashes
ehthumbs.db
Thumbs.db

# ==========================================
# 编辑器与 IDE (IDEs & Editors)
# ==========================================
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.idea/
*.swp
*.swo
*~

# ==========================================
# 环境变量与私密配置 (Environment & Secrets)
# ==========================================
.env*
!.env.example
!.env.template
.envrc

# 凭据、证书私钥与本地密钥库
*.key
*.pem
*.p12
*.pfx
credentials*.json
secrets*.json

# ==========================================
# Python & 虚拟环境 (Python & Virtual Environments)
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
ENV/

# ==========================================
# Python 构建与测试 (Python Build & Test Caches)
# ==========================================
build/
dist/
*.egg-info/
.eggs/
*.egg
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ==========================================
# Node.js & 前端 (Node.js & Frontend)
# ==========================================
node_modules/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ==========================================
# 项目特定数据、产物与离线依赖 (Project Specifics)
# ==========================================
# 运行时数据、模型、日志、SQLite数据库
data/
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.log

# 离线 Wheel 包目录
vendor/wheelhouse/
vendor/cpu-runtime-wheelhouse/

# 飞牛 FNOS 应用打包产物
*.fpk

# 本地 AI/编辑器配置与开发过程记录
/.claude/settings.local.json
/.codex/
/.cursor/
/prompt.md
/walkthrough.md
