#!/bin/bash
set -Eeuo pipefail

# Heavy runtimes, models and user data live in a persistent fnOS data-share.
# Missing or unknown actions preserve it so unattended uninstall is safe.
DATA_ACTION="${wizard_data_action:-keep}"

validate_data_dir() {
  local path="$1"
  if [[ ! "$path" =~ ^/vol[0-9]+/.+/paddle-formula-ocr/data$ ]] || [[ -L "$path" ]]; then
    echo "拒绝清理非公式 OCR 工作台数据目录：$path" >&2
    exit 1
  fi
}

validate_config_dir() {
  local path="$1"
  if [[ ! "$path" =~ ^/vol[0-9]+/@appconf/paddle-formula-ocr$ ]] || [[ -L "$path" ]]; then
    echo "拒绝清理非公式 OCR 工作台配置目录：$path" >&2
    exit 1
  fi
}

prepare_cleanup_paths() {
  local paths="${TRIM_DATA_SHARE_PATHS:?TRIM_DATA_SHARE_PATHS is required for data cleanup}"
  DATA_DIR="${paths%%:*}"
  DATA_DIR="${DATA_DIR%/}"
  CONFIG_DIR="${TRIM_PKGETC:-}"
  validate_data_dir "$DATA_DIR"
  if [[ -n "$CONFIG_DIR" ]]; then
    validate_config_dir "$CONFIG_DIR"
  fi
}

remove_app_config_dir() {
  if [[ -n "$CONFIG_DIR" ]]; then
    rm -rf -- "$CONFIG_DIR"
  fi
}

remove_non_runtime_data() {
  local entry name

  # Keep only reproducibly installed environments and downloaded models.
  # Settings, user preferences, API-port config, task history, logs, HOME and
  # caches are deliberately discarded so a reinstall starts from clean state.
  shopt -s dotglob nullglob
  for entry in "$DATA_DIR"/*; do
    name="${entry##*/}"
    case "$name" in
      runtimes|models)
        ;;
      *)
        rm -rf -- "$entry"
        ;;
    esac
  done
  shopt -u dotglob nullglob
}

remove_all_data() {
  local entry
  shopt -s dotglob nullglob
  for entry in "$DATA_DIR"/*; do
    rm -rf -- "$entry"
  done
  shopt -u dotglob nullglob
}

case "$DATA_ACTION" in
  keep_runtime)
    prepare_cleanup_paths
    remove_non_runtime_data
    remove_app_config_dir
    ;;
  delete)
    prepare_cleanup_paths
    remove_all_data
    remove_app_config_dir
    ;;
  keep|*)
    # Preserve the data-share. fnOS may remove the private control venv;
    # install_callback rebuilds it on the next installation.
    ;;
esac
