#!/bin/bash
set -euo pipefail

APP_DIR="${TRIM_APPDEST}/server"
CONTROL_VENV="${TRIM_PKGVAR}/control-venv"
PYTHON_BIN="${CONTROL_VENV}/bin/python"
PID_FILE="${TRIM_PKGVAR}/app.pid"
LOG_FILE="${TRIM_PKGVAR}/app.log"
SOCKET_PATH="${TRIM_APPDEST}/app.sock"

resolve_data_dir() {
  local paths="${TRIM_DATA_SHARE_PATHS:-}"
  if [ -z "$paths" ]; then
    echo "fnOS 未提供持久数据目录，请重新安装应用以创建 data-share。" > "$TRIM_TEMP_LOGFILE"
    exit 1
  fi
  DATA_DIR="${paths%%:*}"
  DATA_DIR="${DATA_DIR%/}"
  if [[ "$DATA_DIR" != /* ]] || [ ! -d "$DATA_DIR" ] || [ ! -w "$DATA_DIR" ]; then
    echo "fnOS 持久数据目录无效或不可写：${DATA_DIR}" > "$TRIM_TEMP_LOGFILE"
    exit 1
  fi
}

is_running() {
  if [ ! -f "$PID_FILE" ]; then
    return 1
  fi
  local pid
  pid="$(tr -d '[:space:]' < "$PID_FILE")"
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

validate_port() {
  local value="$1"
  [[ "$value" =~ ^[0-9]+$ ]] && [ "$value" -ge 1024 ] && [ "$value" -le 65535 ]
}

load_port_config() {
  local configured_port="8504"
  if [ -f "$TRIM_PKGVAR/env" ]; then
    while IFS='=' read -r key value; do
      case "$key" in
        FORMULA_OCR_API_PORT|TRIM_SERVICE_PORT)
          if validate_port "$value"; then
            configured_port="$value"
          else
            echo "忽略 env 中的无效局域网 API 端口：${value}" >> "$LOG_FILE"
          fi
          ;;
      esac
    done < "$TRIM_PKGVAR/env"
  fi
  FORMULA_OCR_API_PORT="$configured_port"
  TRIM_SERVICE_PORT="$configured_port"
  export FORMULA_OCR_API_PORT TRIM_SERVICE_PORT
}

start_app() {
  if is_running; then
    return 0
  fi
  if [ ! -x "$PYTHON_BIN" ]; then
    echo "控制平面运行时未安装，请重新安装应用。" > "$TRIM_TEMP_LOGFILE"
    exit 1
  fi
  resolve_data_dir
  rm -f "$SOCKET_PATH"
  load_port_config
  APP_TEMP_DIR="${TRIM_PKGTMP:-$TRIM_PKGVAR/tmp}"
  mkdir -p "$APP_TEMP_DIR"
  FORMULA_OCR_APP_ROOT="$APP_DIR" \
  FORMULA_OCR_DATA_DIR="$DATA_DIR" \
  FORMULA_OCR_TEMP_DIR="$APP_TEMP_DIR" \
  FORMULA_OCR_STATIC_DIR="$APP_DIR/static" \
  FORMULA_OCR_GATEWAY_PREFIX="/app/paddle-formula-ocr" \
  FORMULA_OCR_API_PORT="${FORMULA_OCR_API_PORT:-${TRIM_SERVICE_PORT:-8504}}" \
  TMPDIR="$APP_TEMP_DIR" \
  PYTHONPATH="$APP_DIR/src" \
  "$PYTHON_BIN" -m formula_ocr.app --socket "$SOCKET_PATH" >> "$LOG_FILE" 2>&1 &
  echo "$!" > "$PID_FILE"
}

stop_app() {
  if ! is_running; then
    rm -f "$PID_FILE" "$SOCKET_PATH"
    return 0
  fi
  local pid retries=0
  pid="$(tr -d '[:space:]' < "$PID_FILE")"
  kill -TERM "$pid" 2>/dev/null || true
  while kill -0 "$pid" 2>/dev/null && [ "$retries" -lt 10 ]; do
    sleep 1
    retries=$((retries + 1))
  done
  if kill -0 "$pid" 2>/dev/null; then
    kill -KILL "$pid" 2>/dev/null || true
  fi
  rm -f "$PID_FILE" "$SOCKET_PATH"
}

case "${1:-}" in
  start) start_app ;;
  stop) stop_app ;;
  status) is_running && exit 0; exit 3 ;;
  *) echo "Unknown command: ${1:-}" > "$TRIM_TEMP_LOGFILE"; exit 1 ;;
esac
