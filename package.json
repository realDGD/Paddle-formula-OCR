{
  "name": "paddle-formula-ocr-assets",
  "private": true,
  "version": "0.3.138",
  "description": "Frontend assets for the Formula and Table OCR Workbench",
  "scripts": {
    "build": "npm run typecheck && npm run build:app && npm run build:editor",
    "build:app": "esbuild frontend/app/main.ts --bundle --format=iife --platform=browser --target=es2020 --outfile=static/app.js",
    "build:editor": "esbuild frontend/latex-editor.ts --bundle --minify --format=iife --platform=browser --target=es2020 --outfile=static/vendor/codemirror/latex-editor.js",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@lezer/highlight": "^1.2.3",
    "@mathjax/mathjax-bbm-font-extension": "^4.1.3",
    "@mathjax/mathjax-bboldx-font-extension": "^4.1.3",
    "@mathjax/mathjax-dsfont-font-extension": "^4.1.3",
    "@mathjax/mathjax-mhchem-font-extension": "^4.1.3",
    "esbuild": "^0.28.1",
    "mathjax": "^4.1.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@revolist/revogrid": "4.26.2",
    "katex": "0.16.21",
    "mathlive": "^0.110.0"
  }
}
